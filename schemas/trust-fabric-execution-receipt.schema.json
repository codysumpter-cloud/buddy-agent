{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismtek.dev/schemas/trust-fabric-execution-receipt.schema.json",
  "title": "Prismtek Trust Fabric execution receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "task_id",
    "claim",
    "status",
    "decision",
    "verified",
    "artifact_accepted",
    "security_gate",
    "evidence_refs",
    "checked_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1 },
    "status": { "enum": ["source_backed", "blocked", "verified"] },
    "decision": { "enum": ["allow", "review", "block"] },
    "verified": { "type": "boolean" },
    "artifact_accepted": { "type": "boolean" },
    "security_gate": { "enum": ["pass", "review", "block", "not-run"] },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
    },
    "checked_at": { "type": "string" },
    "reviewer": { "type": "string" },
    "review_approved": { "type": "boolean" },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
