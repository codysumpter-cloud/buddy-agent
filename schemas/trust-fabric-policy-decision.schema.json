{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismtek.dev/schemas/trust-fabric-policy-decision.schema.json",
  "title": "Prismtek Trust Fabric policy decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "evaluated_at",
    "risk_level",
    "decision",
    "reasons",
    "required_actions",
    "stale_source_ids",
    "conflicting_source_ids"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "evaluated_at": { "type": "string" },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "decision": { "enum": ["allow", "review", "block"] },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "required_actions": { "type": "array", "items": { "type": "string" } },
    "stale_source_ids": { "type": "array", "items": { "type": "string" } },
    "conflicting_source_ids": { "type": "array", "items": { "type": "string" } }
  }
}
